#!/usr/bin/env bash

set -Eeuo pipefail

temporary_directory=

# Describe the clipboard transfer and explicit cleanup commands.
usage() {
  cat <<'EOF'
Usage:
  work-image
  personal-image
  work-image clean [--older-than Nd]
  personal-image clean [--older-than Nd]

Run on the Mac holding the image clipboard. With no arguments, each command
uploads to its VM and copies an inspection prompt to the clipboard. Clean
previews helper-owned PNG files and requires the VM alias as confirmation.
Images do not expire automatically.
EOF
}

# Report an error without changing the clipboard.
die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

# Remove only the temporary image created by this invocation.
cleanup() {
  if [[ -n "$temporary_directory" ]]; then
    rm -f "$temporary_directory/image.png"
    rmdir "$temporary_directory"
  fi
}

# Supply the remote implementation without installing a service on the VM.
remote_program() {
  cat <<'PY'
import os
import re
import shlex
import stat
import sys
import time
import uuid
from pathlib import Path


def image_directory(create):
    """Open the private image directory without following symlink components."""
    home = Path.home()
    path = home
    descriptor = os.open(home, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        for component in (".local", "share", "dev-machine", "images"):
            path /= component
            if create:
                try:
                    os.mkdir(component, 0o700, dir_fd=descriptor)
                except FileExistsError:
                    pass
            try:
                child = os.open(component, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW,
                                dir_fd=descriptor)
            except FileNotFoundError:
                if not create:
                    return path, None
                raise
            os.close(descriptor)
            descriptor = child
            details = os.fstat(descriptor)
            if details.st_uid != os.getuid() or details.st_mode & 0o022:
                raise ValueError(f"Directory must be owned by you and not writable by others: {path}")
        if os.fstat(descriptor).st_mode & 0o077:
            raise ValueError(f"Image directory must have mode 700: {path}")
        result = descriptor
        descriptor = None
        return path, result
    finally:
        if descriptor is not None:
            os.close(descriptor)


def send(expected_size):
    """Publish a complete PNG under a unique name and print its quoted path."""
    path, directory = image_directory(True)
    identifier = uuid.uuid4().hex
    name = f"dev-image-{identifier}.png"
    temporary = f".dev-image-{identifier}.part"
    try:
        descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL,
                             0o600, dir_fd=directory)
        try:
            with os.fdopen(descriptor, "wb") as output:
                header = sys.stdin.buffer.read(8)
                if header != b"\x89PNG\r\n\x1a\n":
                    raise ValueError("Clipboard capture is not a PNG")
                output.write(header)
                size = len(header)
                while chunk := sys.stdin.buffer.read(65536):
                    size += len(chunk)
                    if size > expected_size:
                        raise ValueError("Image transfer exceeded its expected size")
                    output.write(chunk)
                if size != expected_size:
                    raise ValueError("Image transfer was incomplete")
            os.link(temporary, name, src_dir_fd=directory, dst_dir_fd=directory)
        finally:
            os.unlink(temporary, dir_fd=directory)
        print(shlex.quote(str(path / name)))
    finally:
        os.close(directory)


def fingerprint(details):
    """Identify the exact regular file approved for deletion."""
    return (details.st_dev, details.st_ino, details.st_mode,
            details.st_size, details.st_mtime_ns, details.st_ctime_ns)


def clean(target, days):
    """Preview and confirm deletion of a fixed set of helper image files."""
    path, directory = image_directory(False)
    if directory is None:
        print(f"No image directory on {target}.")
        return
    try:
        cutoff = time.time() - days * 86400 if days else None
        candidates = []
        for name in sorted(os.listdir(directory)):
            if not re.fullmatch(r"dev-image-[0-9a-f]{32}\.png", name):
                continue
            details = os.stat(name, dir_fd=directory, follow_symlinks=False)
            if not stat.S_ISREG(details.st_mode) or details.st_uid != os.getuid():
                continue
            if cutoff is not None and details.st_mtime >= cutoff:
                continue
            candidates.append((name, fingerprint(details)))
        print(f"VM: {target}\nDirectory: {path}")
        print(f"Files: {len(candidates)}\nSize: {sum(item[1][3] for item in candidates)} bytes")
        if not candidates:
            return
        answer = input(f"Type {target} to delete these images: ")
        if answer != target:
            print("Cancelled; no images deleted.")
            return
        for name, original in candidates:
            details = os.stat(name, dir_fd=directory, follow_symlinks=False)
            if fingerprint(details) != original:
                raise ValueError("Images changed after preview; run clean again")
        for name, _ in candidates:
            os.unlink(name, dir_fd=directory)
        print(f"Deleted {len(candidates)} images.")
    finally:
        os.close(directory)


def main():
    """Dispatch the validated client request on the selected VM."""
    if sys.argv[1] == "send":
        send(int(sys.argv[3]))
    else:
        clean(sys.argv[2], int(sys.argv[3]))


try:
    main()
except (OSError, ValueError, EOFError) as error:
    print(f"error: {error}", file=sys.stderr)
    sys.exit(1)
PY
}

# Validate the exact VM and arguments before reading or transferring an image.
main() {
  local action="${1:-}" target="${2:-}" days=0
  local encoded_program remote_command remote_path image_size dependency

  if [[ $# -eq 1 && ( "$action" == --help || "$action" == -h || "$action" == help ) ]]; then
    usage
    return
  fi
  case "$target" in
    work-dev|personal-dev) ;;
    *) usage >&2; die "Choose exactly one VM: work-dev or personal-dev." ;;
  esac
  case "$action" in
    help|-h|--help)
      [[ $# -eq 2 ]] || die "Help does not accept extra arguments."
      usage
      return
      ;;
    send) [[ $# -eq 2 ]] || die "Image sending does not accept extra arguments." ;;
    clean)
      if [[ $# -eq 4 && "$3" == --older-than && "$4" =~ ^[1-9][0-9]{0,5}d$ ]]; then
        days="${4%d}"
      elif [[ $# -ne 2 ]]; then
        die "Cleanup accepts only --older-than Nd, with 1 to 999999 days."
      fi
      ;;
    *) usage >&2; die "Unknown command: $action" ;;
  esac
  [[ "$(uname -s)" == Darwin ]] || die "Run work-image or personal-image on the Mac holding your clipboard."
  command -v ssh >/dev/null 2>&1 || die "OpenSSH is required."
  encoded_program="$(remote_program | base64 | tr -d '\r\n')"
  remote_command="python3 -c 'import base64; exec(base64.b64decode(\"$encoded_program\"))'"

  if [[ "$action" == clean ]]; then
    ssh -T "$target" "$remote_command clean $target $days"
    return
  fi

  for dependency in pngpaste pbcopy; do
    command -v "$dependency" >/dev/null 2>&1 || die "$dependency is required; install the Air profile (or brew install pngpaste)."
  done
  umask 077
  temporary_directory="$(mktemp -d "${TMPDIR:-/tmp}/dev-image.XXXXXX")"
  pngpaste "$temporary_directory/image.png" || die "Could not capture a clipboard image; copy an image and retry."
  [[ -s "$temporary_directory/image.png" ]] || die "The clipboard image is empty."
  image_size="$(wc -c < "$temporary_directory/image.png" | tr -d '[:space:]')"
  remote_path="$(ssh -T "$target" "$remote_command send $target $image_size" < "$temporary_directory/image.png")" \
    || die "Image transfer failed; your clipboard is unchanged."
  [[ -n "$remote_path" && "$remote_path" != *$'\n'* ]] || die "Unexpected transfer response; your clipboard is unchanged."
  printf 'Uploaded to %s: %s\n' "$target" "$remote_path"
  printf 'Inspect this image: %s\n' "$remote_path" | pbcopy \
    || die "Image uploaded, but clipboard update failed. Use the path printed above."
  printf 'Inspection prompt copied. Paste it into Codex on %s.\n' "$target"
}

trap cleanup EXIT
main "$@"
